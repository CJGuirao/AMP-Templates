Meta.DisplayName=ClubÑ AI Bot
Meta.Description=Discord Q&A bot for ClubÑ: a local Liquid AI LFM3 model on CPU checks every question against the server rules and answers only from cited sources
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Carlos Jimenez
Meta.URL=https://github.com/CJGuirao/AMP-Templates
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=clubn-ai-botconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=clubn-ai-bot.kvp
Meta.MinAMPVersion=2.5.0.0
Meta.SpecificDockerImage=ghcr.io/cjguirao/amp-clubn-ai-bot:latest
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnLinux
Meta.ContainerPolicyReason=Runs Ollama and the bot together in one container so the model endpoint is reachable only from inside the instance. Models, rules, knowledge files and logs persist under /AMP/clubn-ai-bot.
Meta.ExtraSetupStepsURI=https://github.com/CJGuirao/AMP-Templates/blob/main/clubn-ai-bot/README.md
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1.0
Meta.ReleaseNotes=Initial ClubÑ AI Bot template. Run Update once to install the bot and download the model, then Start.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=744e8c55-10a3-4d66-b50a-9556fe75f25e
Meta.ImportableExtensions=[]
App.DisplayName=ClubÑ AI Bot
App.RootDir=./clubn-ai-bot/
App.BaseDirectory=./clubn-ai-bot/
App.ExecutableWin=
App.ExecutableLinux=/usr/local/bin/clubn-amp-run
App.WorkingDir=.
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"CLUBN_DATA_DIR":"/AMP/clubn-ai-bot","HOME":"/AMP/clubn-ai-bot/home","TZ":"{{Timezone}}","PYTHONUNBUFFERED":"1","CLUBN_DISCORD_TOKEN":"{{DiscordToken}}","CLUBN_GUILD_ID":"{{GuildId}}","CLUBN_COMMAND_NAME":"{{CommandName}}","CLUBN_ALLOWED_CHANNEL_IDS":"{{AllowedChannelIds}}","CLUBN_ALLOWED_ROLE_IDS":"{{AllowedRoleIds}}","CLUBN_MOD_LOG_CHANNEL_ID":"{{ModLogChannelId}}","CLUBN_ANSWER_ON_MENTION":"{{AnswerOnMention}}","CLUBN_MODEL":"{{Model}}","CLUBN_KEEP_ALIVE":"{{KeepAlive}}","CLUBN_NUM_CTX":"{{NumCtx}}","CLUBN_NUM_THREADS":"{{NumThreads}}","CLUBN_THINK":"{{Think}}","CLUBN_LLM_TIMEOUT":"{{LlmTimeout}}","CLUBN_RULES_TEXT":"{{RulesText}}","CLUBN_COOLDOWN_S":"{{CooldownSeconds}}","CLUBN_DAILY_LIMIT":"{{DailyLimit}}","CLUBN_MAX_QUESTION_CHARS":"{{MaxQuestionChars}}","CLUBN_QUEUE_SIZE":"{{QueueSize}}","CLUBN_CHECK_OUTPUT":"{{CheckOutput}}","CLUBN_BLOCKED_PATTERNS":"{{BlockedPatterns}}","CLUBN_WEB_SEARCH":"{{WebSearch}}","CLUBN_SEARXNG_URL":"{{SearxngUrl}}","CLUBN_WIKIPEDIA_LANGS":"{{WikipediaLangs}}","CLUBN_MAX_WEB_RESULTS":"{{MaxWebResults}}","CLUBN_FETCH_PAGES":"{{FetchPages}}","CLUBN_BLOCKED_DOMAINS":"{{BlockedDomains}}","CLUBN_SOURCE_REPO":"{{SourceRepo}}","CLUBN_SOURCE_REF":"{{SourceRef}}"}
App.CommandLineParameterFormat=--{0} "{1}"
App.CommandLineParameterDelimiter=
App.ExitMethod=SIGTERM
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
