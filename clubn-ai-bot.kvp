Meta.DisplayName=ClubÑ AI Bot
Meta.Description=Discord Q&A bot for ClubÑ: local Liquid AI models on CPU check every question against the server rules and answers only from cited sources
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Carlos Jimenez
Meta.URL=https://github.com/CJGuirao/AMP-Templates
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=clubn-ai-botconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=clubn-ai-bot.kvp
Meta.MinAMPVersion=2.5.0.0
Meta.SpecificDockerImage=ghcr.io/cjguirao/amp-clubn-ai-bot:latest
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnLinux
Meta.ContainerPolicyReason=Runs Ollama and the bot together in one container so the model endpoint is reachable only from inside the instance. Models, rules, knowledge files and logs persist under /AMP/clubn-ai-bot.
Meta.ExtraSetupStepsURI=https://github.com/CJGuirao/AMP-Templates/blob/main/src/clubn-ai-bot/README.md
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1.0
Meta.ReleaseNotes=Initial ClubÑ AI Bot template. Run Update once to install the bot and download the model, then Start.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=744e8c55-10a3-4d66-b50a-9556fe75f25e
