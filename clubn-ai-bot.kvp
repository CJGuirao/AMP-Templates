App.EnvironmentVariables={"CLUBN_DATA_DIR":"/AMP/clubn-ai-bot","HOME":"/AMP/clubn-ai-bot/home","TZ":"{{Timezone}}","PYTHONUNBUFFERED":"1","CLUBN_DISCORD_TOKEN":"{{DiscordToken}}","CLUBN_GUILD_ID":"{{GuildId}}","CLUBN_COMMAND_NAME":"{{CommandName}}","CLUBN_ALLOWED_CHANNEL_IDS":"{{AllowedChannelIds}}","CLUBN_ALLOWED_ROLE_IDS":"{{AllowedRoleIds}}","CLUBN_MOD_LOG_CHANNEL_ID":"{{ModLogChannelId}}","CLUBN_ANSWER_ON_MENTION":"{{AnswerOnMention}}","CLUBN_SYSTEM_PROMPT":"{{SystemPrompt}}","CLUBN_PERSONALITY":"{{Personality}}","CLUBN_ANSWER_MODE":"{{AnswerMode}}","CLUBN_MODEL":"{{Model}}","CLUBN_CHECK_MODEL":"{{CheckModel}}","CLUBN_KEEP_ALIVE":"{{KeepAlive}}","CLUBN_NUM_CTX":"{{NumCtx}}","CLUBN_NUM_THREADS":"{{NumThreads}}","CLUBN_THINK":"{{Think}}","CLUBN_LLM_TIMEOUT":"{{LlmTimeout}}","CLUBN_RULES_TEXT":"{{RulesText}}","CLUBN_COOLDOWN_S":"{{CooldownSeconds}}","CLUBN_DAILY_LIMIT":"{{DailyLimit}}","CLUBN_MAX_QUESTION_CHARS":"{{MaxQuestionChars}}","CLUBN_QUEUE_SIZE":"{{QueueSize}}","CLUBN_CHECK_OUTPUT":"{{CheckOutput}}","CLUBN_BLOCKED_PATTERNS":"{{BlockedPatterns}}","CLUBN_WEB_SEARCH":"{{WebSearch}}","CLUBN_SEARXNG_URL":"{{SearxngUrl}}","CLUBN_WIKIPEDIA_LANGS":"{{WikipediaLangs}}","CLUBN_MAX_WEB_RESULTS":"{{MaxWebResults}}","CLUBN_FETCH_PAGES":"{{FetchPages}}","CLUBN_BLOCKED_DOMAINS":"{{BlockedDomains}}","CLUBN_SOURCE_REPO":"{{SourceRepo}}","CLUBN_SOURCE_REF":"{{SourceRef}}","CLUBN_LOG_LEVEL":"{{LogLevel}}","CLUBN_WEB_ENABLED":"{{ClubWebEnabled}}","CREATOR_ROLE_NAME":"{{WebCreatorRoleName}}","CREATOR_ROLE_ID":"{{WebCreatorRoleId}}","REVIEW_CHANNEL_ID":"{{WebReviewChannelId}}","MOD_ROLE_IDS":"{{WebModRoleIds}}","ANNOUNCE_CHANNEL_IDS":"{{WebAnnounceChannelIds}}","ANNOUNCE_HISTORY_LIMIT":"{{WebAnnounceHistoryLimit}}","BACKFILL_EXISTING":"{{WebBackfillExisting}}","BACKFILL_PER_SWEEP":"{{WebBackfillPerSweep}}","LEDGER_CHANNEL_ID":"{{WebLedgerChannelId}}","DAILY_SWEEP_HOUR":"{{WebDailySweepHour}}","EVENTS_ENABLED":"{{WebEventsEnabled}}","EVENT_CHANNEL_IDS":"{{WebEventChannelIds}}","EVENT_REVIEW_CHANNEL_ID":"{{WebEventReviewChannelId}}","EVENT_TRACK_DAYS_AFTER":"{{WebEventTrackDaysAfter}}","EVENT_DEFAULT_HOURS":"{{WebEventDefaultHours}}","WP_EVENTS_CATEGORY":"{{WebEventsCategory}}","CALENDAR_URL":"{{WebCalendarUrl}}","MOMENTAZOS_ENABLED":"{{WebMomentazosEnabled}}","MOMENTAZOS_PAGE_ID":"{{WebMomentazosPageId}}","MOMENTAZOS_CHANNEL_ID":"{{WebMomentazosChannelId}}","MOMENTAZOS_PLAYLIST_ID":"{{WebMomentazosPlaylistId}}","MOMENTAZOS_INTERVAL_HOURS":"{{WebMomentazosIntervalHours}}","MOMENTAZOS_TITLE_REGEX":"{{WebMomentazosTitleRegex}}","MOMENTAZOS_ALLOW_DRAFT":"{{WebMomentazosAllowDraft}}","MOMENTAZOS_NOTIFY_CHANNEL_ID":"{{WebMomentazosNotifyChannelId}}","LIVE_ENABLED":"{{WebLiveEnabled}}","LIVE_DB_CHANNEL_ID":"{{WebLiveDbChannelId}}","LIVE_DB_RELOAD_MIN":"{{WebLiveDbReloadMin}}","LIVE_PAGE_ID":"{{WebLivePageId}}","LIVE_INTERVAL_MIN":"{{WebLiveIntervalMin}}","LIVE_YT_INTERVAL_MIN":"{{WebLiveYtIntervalMin}}","LIVE_YT_FEED_ITEMS":"{{WebLiveYtFeedItems}}","MIS_REDES_ENABLED":"{{WebMisRedesEnabled}}","MIS_REDES_REVIEW_CHANNEL_ID":"{{WebMisRedesReviewChannelId}}","MIS_REDES_COOLDOWN_MIN":"{{WebMisRedesCooldownMin}}","MIS_REDES_MAX_PER_DAY":"{{WebMisRedesMaxPerDay}}","MIS_REDES_MAX_PENDING":"{{WebMisRedesMaxPending}}","MIS_REDES_EXPIRE_DAYS":"{{WebMisRedesExpireDays}}","MIS_REDES_SELF_APPROVE":"{{WebMisRedesSelfApprove}}","MIS_REDES_DM":"{{WebMisRedesDm}}","WP_URL":"{{WebWpUrl}}","WP_FALLBACK_URL":"{{WebWpFallbackUrl}}","WP_USER":"{{WebWpUser}}","WP_APP_PASSWORD":"{{WebWpAppPassword}}","WP_CATEGORY_NAME":"{{WebWpCategoryName}}","WP_FEATURED_TAG":"{{WebWpFeaturedTag}}","WP_FRONT_BLOCK_TITLE":"{{WebWpFrontBlockTitle}}","ANTHROPIC_API_KEY":"{{WebAnthropicApiKey}}","CLAUDE_MODEL":"{{WebClaudeModel}}","CLAUDE_EFFORT":"{{WebClaudeEffort}}","DEEPSEEK_API_KEY":"{{WebDeepseekApiKey}}","DEEPSEEK_MODEL":"{{WebDeepseekModel}}","DEEPSEEK_BASE_URL":"{{WebDeepseekBaseUrl}}","YOUTUBE_API_KEY":"{{WebYoutubeApiKey}}","TWITCH_CLIENT_ID":"{{WebTwitchClientId}}","TWITCH_CLIENT_SECRET":"{{WebTwitchClientSecret}}","SOCIAL_ENABLED":"{{WebSocialEnabled}}","SOCIAL_DRY_RUN":"{{WebSocialDryRun}}","SOCIAL_REVIEW_CHANNEL_ID":"{{WebSocialReviewChannelId}}","SOCIAL_COMMAND_ROLE_IDS":"{{WebSocialCommandRoleIds}}","SOCIAL_DEFAULT_LINK":"{{WebSocialDefaultLink}}","SOCIAL_NETWORKS":"{{WebSocialNetworks}}","SOCIAL_WATCH_WEB":"{{WebSocialWatchWeb}}","SOCIAL_WP_CATEGORIES":"{{WebSocialWpCategories}}","SOCIAL_POLL_MIN":"{{WebSocialPollMin}}","SOCIAL_MAX_AGE_HOURS":"{{WebSocialMaxAgeHours}}","SOCIAL_HASHTAGS":"{{WebSocialHashtags}}","SOCIAL_STYLE":"{{WebSocialStyle}}","POSTIZ_URL":"{{WebPostizUrl}}","POSTIZ_API_KEY":"{{WebPostizApiKey}}","SOCIAL_TIKTOK_METHOD":"{{WebSocialTiktokMethod}}","TIKTOK_CLIENT_KEY":"{{WebTiktokClientKey}}","TIKTOK_CLIENT_SECRET":"{{WebTiktokClientSecret}}","TIKTOK_REFRESH_TOKEN":"{{WebTiktokRefreshToken}}","TIKTOK_REDIRECT_URI":"{{WebTiktokRedirectUri}}","TIKTOK_PRIVACY":"{{WebTiktokPrivacy}}","BLUESKY_HANDLE":"{{WebBlueskyHandle}}","BLUESKY_APP_PASSWORD":"{{WebBlueskyAppPassword}}","BLUESKY_PDS":"{{WebBlueskyPds}}","META_GRAPH_VERSION":"{{WebMetaGraphVersion}}","FACEBOOK_PAGE_ID":"{{WebFacebookPageId}}","INSTAGRAM_USER_ID":"{{WebInstagramUserId}}","META_PAGE_TOKEN":"{{WebMetaPageToken}}","X_API_KEY":"{{WebXApiKey}}","X_API_SECRET":"{{WebXApiSecret}}","X_ACCESS_TOKEN":"{{WebXAccessToken}}","X_ACCESS_SECRET":"{{WebXAccessSecret}}","THREADS_USER_ID":"{{WebThreadsUserId}}","THREADS_TOKEN":"{{WebThreadsToken}}"}
