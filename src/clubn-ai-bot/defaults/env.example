# Club Ñ web features: optional fallback for AMP's configuration panel.
# Everything here can (and normally should) be set in AMP > Configuration > Club Ñ Web.
# A value filled in AMP wins; a blank AMP field is taken from this file.
# Copy to .env in the instance folder (/AMP/clubn-ai-bot/.env). Never commit the real .env.

# DISCORD_TOKEN=            # only if 'Discord Bot Token' is blank in AMP
# CLUBN_WEB_ENABLED=true    # same as the 'Club Ñ Web Features' checkbox

# ---------- Discord and creators ----------
CREATOR_ROLE_NAME=creador de contenido       # Creator Role Name
CREATOR_ROLE_ID=805106840266080256           # Creator Role ID
REVIEW_CHANNEL_ID=1216376131360657528        # Mod Review Channel ID
MOD_ROLE_IDS=                                # Moderator Role IDs
ANNOUNCE_CHANNEL_IDS=810238345044164719      # Live Announcement Channel IDs
ANNOUNCE_HISTORY_LIMIT=3000                  # Announcement History Limit
BACKFILL_EXISTING=true                       # Write Articles For Existing Creators
BACKFILL_PER_SWEEP=3                         # Existing Creators Per Day
DAILY_SWEEP_HOUR=9                           # Daily Sweep Hour

# ---------- Events calendar ----------
EVENTS_ENABLED=true                          # Events Workflow
EVENT_CHANNEL_IDS=                           # Event Channel IDs
EVENT_REVIEW_CHANNEL_ID=                     # Event Review Channel ID
EVENT_TRACK_DAYS_AFTER=7                     # Track Days After Event
EVENT_DEFAULT_HOURS=2                        # Default Event Length (hours)
WP_EVENTS_CATEGORY=Eventos                   # Events Category
CALENDAR_URL=/calendario/                    # Calendar URL

# ---------- Momentazos page ----------
MOMENTAZOS_ENABLED=true                      # Momentazos Page Updates
MOMENTAZOS_PAGE_ID=                          # Momentazos Page ID
MOMENTAZOS_CHANNEL_ID=UCXW5p9ZwR1kVsN2sEHNHylg # YouTube Channel ID
MOMENTAZOS_PLAYLIST_ID=PLYEqrW81W849ASmCYn_9uYClE_jn3D3J8 # Momentazos Playlist ID
MOMENTAZOS_INTERVAL_HOURS=6                  # Check Interval (hours)
MOMENTAZOS_TITLE_REGEX=                      # Title Pattern
MOMENTAZOS_ALLOW_DRAFT=false                 # Allow Draft Page
MOMENTAZOS_NOTIFY_CHANNEL_ID=                # Notify Channel ID

# ---------- Ahora en directo ----------
LIVE_ENABLED=false                           # Ahora En Directo
LIVE_DB_CHANNEL_ID=1574896427719725137       # Creator Database Thread ID
LIVE_DB_RELOAD_MIN=30                        # Database Reload (minutes)
LIVE_PAGE_ID=                                # Ahora En Directo Page ID
LIVE_INTERVAL_MIN=2                          # Twitch Check (minutes)
LIVE_YT_INTERVAL_MIN=6                       # YouTube Check (minutes)
LIVE_YT_FEED_ITEMS=4                         # YouTube Uploads Checked

# ---------- /mis_redes ----------
MIS_REDES_ENABLED=false                      # /mis_redes Command
MIS_REDES_REVIEW_CHANNEL_ID=                 # Review Channel ID
MIS_REDES_COOLDOWN_MIN=10                    # Cooldown (minutes)
MIS_REDES_MAX_PER_DAY=3                      # Requests Per Day
MIS_REDES_MAX_PENDING=25                     # Open Requests Limit
MIS_REDES_EXPIRE_DAYS=14                     # Expire After (days)
MIS_REDES_SELF_APPROVE=false                 # Moderators Approve Own Requests
MIS_REDES_DM=true                            # DM The Outcome

# ---------- WordPress ----------
WP_URL=https://wp.clubn.online               # WordPress URL
WP_FALLBACK_URL=https://clubn.online         # WordPress Fallback URL
WP_USER=                                     # WordPress User
WP_APP_PASSWORD=                             # WordPress Application Password
WP_CATEGORY_NAME=Creadores_de_contenido      # Creators Category
WP_FEATURED_TAG=destacado                    # Featured Tag
WP_FRONT_BLOCK_TITLE=Nuevo creador en Club Ñ # Front-Page Pattern Title

# ---------- AI models ----------
ANTHROPIC_API_KEY=                           # Claude API Key
CLAUDE_MODEL=claude-opus-5-5                 # Claude Model
CLAUDE_EFFORT=high                           # Claude Effort
DEEPSEEK_API_KEY=                            # DeepSeek API Key
DEEPSEEK_MODEL=deepseek-chat                 # DeepSeek Model
DEEPSEEK_BASE_URL=https://api.deepseek.com   # DeepSeek API URL

# ---------- Social APIs ----------
YOUTUBE_API_KEY=                             # YouTube API Key
TWITCH_CLIENT_ID=                            # Twitch Client ID
TWITCH_CLIENT_SECRET=                        # Twitch Client Secret
