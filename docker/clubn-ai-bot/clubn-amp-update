#!/usr/bin/env bash
# Run by AMP's Update action. Downloads the bot code from GitHub, installs its
# dependencies into a persistent virtualenv and downloads the configured model.
# Everything lives in /AMP/clubn-ai-bot, which AMP's File Manager can see.
set -euo pipefail

# Secrets from the AMP settings: only the bot process gets them, never Ollama or the model download.
NO_SECRETS="env -u CLUBN_DISCORD_TOKEN -u DISCORD_TOKEN -u WP_APP_PASSWORD -u ANTHROPIC_API_KEY -u DEEPSEEK_API_KEY -u YOUTUBE_API_KEY -u TWITCH_CLIENT_SECRET -u POSTIZ_API_KEY -u BLUESKY_APP_PASSWORD -u META_PAGE_TOKEN -u THREADS_TOKEN -u X_API_SECRET -u X_ACCESS_TOKEN -u X_ACCESS_SECRET -u TIKTOK_CLIENT_SECRET -u TIKTOK_REFRESH_TOKEN"

APP_HOME="${CLUBN_DATA_DIR:-/AMP/clubn-ai-bot}"
REPO="${CLUBN_SOURCE_REPO:-CJGuirao/AMP-Templates}"
REF="${CLUBN_SOURCE_REF:-main}"
VENV="${APP_HOME}/venv"
APP="${APP_HOME}/app"

if [[ ! "${REPO}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
  echo "Invalid Bot Source Repository '${REPO}'. Use owner/repo." >&2
  exit 2
fi
if [[ ! "${REF}" =~ ^[A-Za-z0-9._/-]+$ || "${REF}" == *..* ]]; then
  echo "Invalid Bot Source Version '${REF}'. Use a branch, tag or commit." >&2
  exit 2
fi

mkdir -p "${APP_HOME}" "${APP_HOME}/home" "${APP_HOME}/models" "${APP_HOME}/logs"
work="$(mktemp -d "${APP_HOME}/.update.XXXXXX")"
temp_ollama=""
cleanup() {
  # Runs on success and on any failure, so a temporary Ollama never outlives the update.
  if [[ -n "${temp_ollama}" ]]; then
    kill -TERM "${temp_ollama}" 2>/dev/null || true
    wait "${temp_ollama}" 2>/dev/null || true
  fi
  rm -rf "${work}"
}
trap cleanup EXIT

echo "Downloading bot code from github.com/${REPO} at ${REF}"
curl -fsSL --proto '=https' --tlsv1.2 "https://codeload.github.com/${REPO}/tar.gz/${REF}" \
  | tar -xz -C "${work}"
src="$(find "${work}" -mindepth 3 -maxdepth 3 -type d -path "*/src/clubn-ai-bot" | head -n 1)"
if [[ -z "${src}" || ! -f "${src}/clubn_bot/__main__.py" ]]; then
  echo "The download does not contain src/clubn-ai-bot/clubn_bot. Check the repository and version settings." >&2
  exit 2
fi

rm -rf "${APP}.new" "${APP}.old"
cp -r "${src}" "${APP}.new"
[[ -d "${APP}" ]] && mv "${APP}" "${APP}.old"
mv "${APP}.new" "${APP}"
rm -rf "${APP}.old"

if [[ ! -x "${VENV}/bin/python" ]]; then
  echo "Creating persistent virtual environment at ${VENV}"
  python3 -m venv "${VENV}"
fi
"${VENV}/bin/python" -m pip install --quiet --upgrade pip
"${VENV}/bin/python" -m pip install --upgrade -r "${APP}/requirements.txt"

# First install only: copy the editable starting files. Existing ones are never overwritten.
[[ -f "${APP_HOME}/rules.md" ]] || cp "${APP}/defaults/rules.md" "${APP_HOME}/rules.md"
mkdir -p "${APP_HOME}/knowledge"
for f in "${APP}/defaults/knowledge/"*; do
  [[ -e "${APP_HOME}/knowledge/$(basename "${f}")" ]] || cp -r "${f}" "${APP_HOME}/knowledge/"
done
# Template for the optional .env fallback (every setting is also in AMP); the real .env is never touched.
cp "${APP}/defaults/env.example" "${APP_HOME}/.env.example"
mkdir -p "${APP_HOME}/data"

# Download or refresh the model. Start a temporary Ollama if the instance isn't running.
export OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MODELS="${APP_HOME}/models"
if ! curl -fs "http://${OLLAMA_HOST}/api/version" >/dev/null 2>&1; then
  ${NO_SECRETS} /usr/bin/ollama serve >/dev/null 2>&1 &
  temp_ollama=$!
  for _ in $(seq 1 30); do
    curl -fs "http://${OLLAMA_HOST}/api/version" >/dev/null 2>&1 && break
    sleep 1
  done
fi
echo "Ollama $(/usr/bin/ollama --version 2>/dev/null | tail -n 1)"
(cd "${APP}" && ${NO_SECRETS} "${VENV}/bin/python" -m clubn_bot pull)

echo "Update complete: bot code from ${REPO}@${REF}, model ${CLUBN_MODEL:-default}. Start the instance."
