#!/usr/bin/env bash
# Run on every AMP instance start. Starts a private Ollama (loopback only, no token in its
# environment) and the Discord bot. If either one exits, the other is stopped and the script
# exits, so AMP's auto-retry restarts the pair cleanly.
set -euo pipefail

# Secrets from the AMP settings: only the bot process gets them, never Ollama or the model download.
NO_SECRETS="env -u CLUBN_DISCORD_TOKEN -u DISCORD_TOKEN -u WP_APP_PASSWORD -u ANTHROPIC_API_KEY -u DEEPSEEK_API_KEY -u YOUTUBE_API_KEY -u TWITCH_CLIENT_SECRET"

APP_HOME="${CLUBN_DATA_DIR:-/AMP/clubn-ai-bot}"
VENV="${APP_HOME}/venv"
APP="${APP_HOME}/app"

if [[ ! -x "${VENV}/bin/python" || ! -f "${APP}/clubn_bot/__main__.py" ]]; then
  echo "ClubÑ AI Bot is not installed. Run AMP Update before starting this instance." >&2
  exit 2
fi
if [[ -z "${CLUBN_DISCORD_TOKEN:-}" ]]    && ! grep -Eq '^[[:space:]]*(export[[:space:]]+)?(CLUBN_)?DISCORD_TOKEN=[^[:space:]#]' "${APP_HOME}/.env" 2>/dev/null; then
  echo "Required AMP setting 'Discord Bot Token' is empty. Set it in the instance configuration, then start again." >&2
  exit 2
fi
[[ -f "${APP_HOME}/.env" ]] && chmod 600 "${APP_HOME}/.env" 2>/dev/null || true

mkdir -p "${APP_HOME}/home" "${APP_HOME}/models" "${APP_HOME}/logs" "${APP_HOME}/knowledge" "${APP_HOME}/data"
[[ -f "${APP_HOME}/rules.md" ]] || cp "${APP}/defaults/rules.md" "${APP_HOME}/rules.md"

export OLLAMA_HOST=127.0.0.1:11434
export OLLAMA_MODELS="${APP_HOME}/models"
export OLLAMA_KEEP_ALIVE="${CLUBN_KEEP_ALIVE:-30m}"
export OLLAMA_CONTEXT_LENGTH="${CLUBN_NUM_CTX:-8192}"
export OLLAMA_NUM_PARALLEL=1
export OLLAMA_MAX_LOADED_MODELS=2  # answer model + small rules-check model
export OLLAMA_MAX_QUEUE=16

# Process substitution keeps $! pointing at Ollama itself (not at the log prefixer).
${NO_SECRETS} /usr/bin/ollama serve > >(sed -u 's/^/[ollama] /') 2>&1 &
ollama_pid=$!

cd "${APP}"
"${VENV}/bin/python" -m clubn_bot run &
bot_pid=$!

stop_all() {
  echo "Stopping ClubÑ AI Bot and Ollama."
  kill -TERM "${bot_pid}" "${ollama_pid}" 2>/dev/null || true
  for _ in $(seq 1 20); do
    kill -0 "${bot_pid}" 2>/dev/null || kill -0 "${ollama_pid}" 2>/dev/null || return 0
    sleep 1
  done
  kill -KILL "${bot_pid}" "${ollama_pid}" 2>/dev/null || true
}
trap 'stop_all; exit 0' TERM INT

code=0
wait -n "${ollama_pid}" "${bot_pid}" || code=$?
echo "A process exited (code ${code}); shutting down so AMP can restart the instance."
stop_all
exit "${code}"
